mdl 1;
-- @version: 11.9+
-- ============================================================================
-- Agent Editor Document Examples
-- ============================================================================
--
-- This file demonstrates the MDL syntax for all four agent-editor document
-- types: Model, Knowledge Base, Consumed MCP Service, and Agent.
--
-- Features demonstrated:
--   - CREATE/DROP CONSUMED MCP SERVICE
--   - CREATE/ALTER/DROP PUBLISHED MCP SERVICE (with tool blocks)
--   - CREATE/DROP KNOWLEDGE BASE
--   - CREATE/DROP AGENT (simple, with variables, with body blocks)
--   - Dollar-quoted multi-line prompts ($$...$$)
--   - Variables: ("Key": EntityAttribute) inline syntax
--   - TOOL, MCP SERVICE, KNOWLEDGE BASE body blocks
--
-- Prerequisites:
--   - The full agent-editor marketplace stack (7 modules) — AgentEditorCommons
--     depends transitively on the rest, so all must be installed:
--       GenAICommons, MxGenAIConnector, AgentCommons, AgentEditorCommons,
--       MCPClient, ConversationalUI, Encryption
--   - Encryption module configured (32-char key)
--   - ASU_AgentEditor registered as after-startup microflow
--
-- ============================================================================

create module AgentTest;

-- ============================================================================
-- Setup: Constants for Model and KB key references
-- ============================================================================

create constant AgentTest."ModelKey"
  ( Type: string, DefaultValue: '' );

create constant AgentTest."KBKey"
  ( Type: string, DefaultValue: '' );

-- The consumed MCP service's server URL (#2060); set it per environment.
create constant AgentTest."WebSearchUrl"
  ( Type: string, DefaultValue: 'https://example.com/mcp' );

-- ============================================================================
-- LEVEL 1: Model (prerequisite for Agents)
-- ============================================================================

create ai model AgentTest."TestModel" (
  Provider: MxCloudGenAI,
  key: @AgentTest.ModelKey
);

-- ============================================================================
-- LEVEL 2: Knowledge Base
-- ============================================================================

create knowledge base AgentTest."ProductDocs" (
  Provider: MxCloudGenAI,
  key: @AgentTest.KBKey
);

-- ============================================================================
-- LEVEL 3: Consumed MCP Service
-- ============================================================================

create consumed mcp service AgentTest."WebSearch" (
  ProtocolVersion: v2025_03_26,
  Endpoint: @AgentTest.WebSearchUrl,
  version: '1.0',
  ConnectionTimeoutSeconds: 30,
  documentation: 'Web search MCP server for research tasks'
);

-- ============================================================================
-- LEVEL 4: Simple Agent (no tools, no body)
-- ============================================================================

create agent AgentTest."Summarizer" (
  UsageType: task,
  model: AgentTest.TestModel,
  SelectedModel: 'eu.anthropic.claude-sonnet-5',
  SystemPrompt: 'Summarize the given text in 3 sentences.',
  UserPrompt: 'Enter text to summarize.'
);

-- ============================================================================
-- LEVEL 5: Agent with Variables
-- ============================================================================

create agent AgentTest."Translator" (
  UsageType: task,
  model: AgentTest.TestModel,
  SelectedModel: 'eu.anthropic.claude-sonnet-5',
  variables: ("Language": EntityAttribute),
  SystemPrompt: 'Translate the text into {{Language}}.',
  UserPrompt: 'Hello world'
);

-- ============================================================================
-- LEVEL 6: Agent with dollar-quoted multi-line prompts
-- ============================================================================

create agent AgentTest."CodeReviewer" (
  UsageType: task,
  model: AgentTest.TestModel,
  SelectedModel: 'eu.anthropic.claude-sonnet-5',
  SystemPrompt: $$You are a code review assistant.

Review the provided code for:
1. security vulnerabilities
2. Performance issues
3. Code style and readability

Provide specific, actionable feedback.$$,
  UserPrompt: $$func main() {
    fmt.Println("Hello, World!")
}$$
);

-- ============================================================================
-- LEVEL 7: Agent with body blocks (MCP SERVICE + KNOWLEDGE BASE)
-- ============================================================================

create agent AgentTest."ResearchAssistant" (
  UsageType: Conversational,
  description: 'Research assistant with web search and documentation',
  model: AgentTest.TestModel,
  SelectedModel: 'eu.anthropic.claude-sonnet-5',
  MaxTokens: 16384,
  ToolChoice: Auto,
  SystemPrompt: 'You are a research assistant. Use available tools.',
  UserPrompt: 'Find information about quantum computing.'
)
{
  mcp service AgentTest.WebSearch (
    Enabled: true
  )

  knowledge base ProductKB (
    source: AgentTest.ProductDocs,
    collection: 'product-docs',
    MaxResults: 5,
    description: 'Product documentation',
    Enabled: true
  )
};

-- ============================================================================
-- LEVEL 8: List and Describe
-- ============================================================================

list agents in AgentTest;
list ai models in AgentTest;
list knowledge bases in AgentTest;
list consumed mcp services in AgentTest;

describe agent AgentTest.ResearchAssistant;
describe ai model AgentTest.TestModel;
describe knowledge base AgentTest.ProductDocs;
describe consumed mcp service AgentTest.WebSearch;

-- ============================================================================
-- LEVEL 9: CREATE OR MODIFY (idempotent upsert)
-- ============================================================================
--
-- All four agent-editor document types support CREATE OR MODIFY.
-- The existing document is updated in-place and its UUID is preserved.
-- Re-run-safe: creates the document if absent, updates it if present.

create or modify ai model AgentTest."TestModel" (
  Provider: MxCloudGenAI,
  key: @AgentTest.ModelKey,
  DisplayName: 'Updated Model Name'
);

create or modify knowledge base AgentTest."ProductDocs" (
  Provider: MxCloudGenAI,
  key: @AgentTest.KBKey
);

create or modify consumed mcp service AgentTest."WebSearch" (
  ProtocolVersion: v2025_03_26,
  version: '1.1',
  ConnectionTimeoutSeconds: 60,
  documentation: 'Updated web search MCP service'
);

create or modify agent AgentTest."ResearchAssistant" (
  UsageType: task,
  model: AgentTest.TestModel,
  MaxTokens: 8192,
  Temperature: 0.5,
  SystemPrompt: $$You are an updated research assistant.$$,
  UserPrompt: 'How can I help you today?'
);

-- ============================================================================
-- LEVEL 10: ALTER (targeted partial updates)
-- ============================================================================
--
-- ALTER patches an existing document without re-specifying every property.
-- Unknown property names error out — use the same names as CREATE.
-- Model, Knowledge Base, and Consumed MCP Service support SET only;
-- Agent additionally supports ADD/DROP for tools, MCP services, and KBs.

-- SET scalar properties on Model.
alter ai model AgentTest.TestModel
    set DisplayName = 'GPT-4 Turbo', KeyName = 'OPENAI_KEY';

-- SET scalar properties on Knowledge Base.
alter knowledge base AgentTest.ProductDocs
    set ModelDisplayName = 'text-embedding-3-small';

-- SET scalar properties (including int) on Consumed MCP Service.
alter consumed mcp service AgentTest.WebSearch
    set ConnectionTimeoutSeconds = 90, Version = '1.2';

-- ALTER AGENT: combine SET with ADD/DROP for collections.
-- Add a TOOL (Microflow), MCP SERVICE, and KNOWLEDGE BASE in one statement.
alter agent AgentTest.ResearchAssistant
    set SystemPrompt = 'Updated assistant prompt.', Temperature = 0.7, MaxTokens = 4096
    add knowledge base ExtraDocs ( Source: AgentTest.ProductDocs, Collection: 'extra', MaxResults: 3 )
    add mcp service AgentTest.WebSearch ( Description: 'web search', Enabled: true );

-- Human-in-the-loop and streaming (ako/mxcli#2021, #2022): approval and
-- display text on a tool, retrieval settings on a knowledge base, streaming
-- on the agent.
alter agent AgentTest.ResearchAssistant
    set EnableBackendStreaming = true
    add mcp service AgentTest.WebSearch ( Enabled: true, UserAccessApproval: UserConfirmationRequired, DisplayTitle: 'Search the web' )
    add knowledge base Faq ( Source: AgentTest.ProductDocs, MaxResults: 5, MinSimilarity: 0.3, IsVisible: false );

alter agent AgentTest.ResearchAssistant
    drop knowledge base Faq
    drop mcp service AgentTest.WebSearch;

-- ALTER AGENT: drop collection entries (TOOL by name, MCP SERVICE by
-- qualified name, KNOWLEDGE BASE by per-agent name).
alter agent AgentTest.ResearchAssistant
    drop knowledge base ExtraDocs
    drop mcp service AgentTest.WebSearch;

-- ============================================================================
-- LEVEL 11: Published MCP Service (Agent Editor 2.6+, MCP Server 5.x)
-- ============================================================================
--
-- The app publishes its own MCP server: each tool is a microflow, started at
-- app startup by AgentEditorCommons through MCPServer.CreateMCPServer and
-- MCPServer.AddTool. Needs the MCP Server module 5.x.

create microflow AgentTest.MCPTool_CountCustomers (
  $NamePrefix: String
)
returns String as $Result
begin
  return 'none yet';
end;

create published mcp service AgentTest.CustomerMCP (
  EndpointPath: 'customers',
  Version: '1.0.0',
  ProtocolVersion: v2025_03_26,
  Documentation: 'Customer tools for external agents'
) {
  tool count_customers (
    Microflow: AgentTest.MCPTool_CountCustomers,
    Description: 'Count the customers whose name starts with NamePrefix.',
    Title: 'Count customers'
  )
};

list published mcp services in AgentTest;
describe published mcp service AgentTest.CustomerMCP;

alter published mcp service AgentTest.CustomerMCP
    set Version = '1.1.0'
    add tool count_all ( Microflow: AgentTest.MCPTool_CountCustomers, Description: 'Count every customer.' )
    drop tool count_customers;

-- ============================================================================
-- Cleanup (reverse dependency order: agents first, then their dependencies)
-- ============================================================================

drop published mcp service AgentTest.CustomerMCP;

drop agent AgentTest.ResearchAssistant;
drop agent AgentTest.CodeReviewer;
drop agent AgentTest.Translator;
drop agent AgentTest.Summarizer;
drop consumed mcp service AgentTest.WebSearch;
drop knowledge base AgentTest.ProductDocs;
drop ai model AgentTest.TestModel;

-- MARK: Microflow Actions with Parameters

-- ============================================================================
-- LEVEL 11b: Microflow Actions with Parameters
-- ============================================================================

/**
 * Process a single product - called from button actions.
 *
 * @param $Product The product to process
 */
create microflow PgTest.ACT_ProcessProduct (
  $Product: PgTest.Product
)
returns boolean as $success
folder 'MicroflowActions'
begin
  declare $success boolean = false;
  log info node 'ProductService' 'Processing product: ' + $Product/Name;
  change $Product (ModifiedDate = [%CurrentDateTime%]);
  commit $Product;
  set $success = true;
  return $success;
end;

/**
 * Client-side nanoflow called from a widget button (Bug 2). A nanoflow widget
 * action must serialize on the default (modelsdk) engine, with its parameter.
 *
 * @param $Product The product passed from the button's data context
 */
create nanoflow PgTest.NAV_RefreshProduct
  ($Product: PgTest.Product)
  folder 'MicroflowActions'
begin
  change $Product (ModifiedDate = [%CurrentDateTime%]) refresh;
  log info 'Refreshed product (client-side)';
end;

/**
 * Delete a product with confirmation - called from button actions.
 *
 * @param $Product The product to delete
 */
create microflow PgTest.ACT_DeleteProduct (
  $Product: PgTest.Product
)
folder 'MicroflowActions'
begin
  log info node 'ProductService' 'Deleting product: ' + $Product/Name;
  delete $Product;
end;

/**
 * DataGrid with microflow action buttons using $currentObject.
 * Demonstrates calling microflows with parameters from list widget rows.
 */
create page PgTest.P023b_DataGrid_MicroflowActions folder 'MicroflowActions'
(
  title: 'Products with Microflow Actions',
  layout: Atlas_Core.Atlas_Default,
  url: 'p023b_datagrid_microflow_actions'
)
{
  layoutgrid mainGrid {
    row {
      column (desktopwidth: 12) {
        dynamictext pageTitle (content: 'Product Management with Microflow Actions', rendermode: H3)
        dynamictext pageDesc (content: 'Click Process to call microflow with $currentObject', rendermode: paragraph)
      }
    }
    row {
      column (desktopwidth: 12) {
        datagrid ProductGrid (datasource: database PgTest.Product) {
          controlbar {
            actionbutton btnNew (
              caption: 'New Product',
              action: create object PgTest.Product then show page PgTest.P012_Product_Manage_Edit,
              buttonstyle: primary
            )
          }
          column (attribute: Name, caption: 'Product Name')
          column (attribute: Code, caption: 'SKU')
          column (attribute: Price, caption: 'Price')
          column (attribute: Stock, caption: 'Stock')
          column (attribute: Name, caption: 'Actions', ShowContentAs: customContent) {
            -- Microflow action with $currentObject passes the current row's product
            actionbutton btnProcess (
              caption: 'Process',
              action: call microflow PgTest.ACT_ProcessProduct(Product = $currentObject),
              buttonstyle: success
            )
            actionbutton btnDelete (
              caption: 'Delete',
              action: call microflow PgTest.ACT_DeleteProduct(Product = $currentObject),
              buttonstyle: danger
            )
          }
        }
      }
    }
  }
};

/**
 * Detail page with microflow action using page parameter.
 * Demonstrates calling microflows with parameters from DataView context.
 *
 * @param $Product The product to view/edit
 */
create page PgTest.P023c_Detail_MicroflowAction folder 'MicroflowActions'
(
  params: (
    $Product: PgTest.Product
  ),
  title: 'Product Details',
  layout: Atlas_Core.PopupLayout,
  url: 'p023c_detail_microflow/{Product/Code}'
)
{
  dataview dvProduct (datasource: $Product) {
    textbox txtName (label: 'Product Name', attribute: Name)
    textbox txtCode (label: 'SKU', attribute: Code)
    textbox txtPrice (label: 'Price', attribute: Price)
    textbox txtStock (label: 'Stock', attribute: Stock)

    footer {
      -- Microflow action with page parameter passes the DataView's object
      actionbutton btnProcess (
        caption: 'Process Product',
        action: call microflow PgTest.ACT_ProcessProduct(Product = $Product),
        buttonstyle: success
      )
      -- Nanoflow (client-side) action with the same page parameter (Bug 2).
      actionbutton btnRefresh (
        caption: 'Refresh',
        action: call nanoflow PgTest.NAV_RefreshProduct(Product = $Product),
        buttonstyle: default
      )
      actionbutton btnSave (caption: 'Save', action: save changes close page, buttonstyle: primary)
      actionbutton btnCancel (caption: 'Cancel', action: cancel changes close page, buttonstyle: default)
    }
  }
};

-- MARK: String Templates

-- ============================================================================
-- LEVEL 12: String Templates with Data Source References
-- ============================================================================

@position(400,100)
create persistent entity PgTest.OrderItem (
  Quantity: integer,
  UnitPrice: decimal,
  LineTotal: decimal,
  ProductName: string(200)
);

create association PgTest.Order_OrderItem
from PgTest.Order to PgTest.OrderItem
type ReferenceSet
owner both;

create association PgTest.OrderItem_Product
from PgTest.OrderItem to PgTest.Product
type reference
owner both;

/**
 * Demonstrates basic string template with ContentParams syntax.
 *
 * @param $Order The order to display
 */
create page PgTest.P024_Template_Basic folder 'Templates'
(
  params: (
    $Order: PgTest.Order
  ),
  title: 'Order Details',
  layout: Atlas_Core.Atlas_Default,
  url: 'p024_template_basic/{Order/OrderNumber}'
)
{
  layoutgrid mainGrid {
    row {
      column (desktopwidth: 12) {
        dataview dvOrder (datasource: $Order) {
          dynamictext txtOrderHeader (
            content: 'Order #{1} - Status: {2}',
            contentparams: ({1} = $order.OrderNumber, {2} = $order.status),
            rendermode: H3
          )

          dynamictext txtOrderDate (
            content: 'Placed on: {1}',
            contentparams: ({1} = $order.OrderDate),
            rendermode: paragraph
          )

          dynamictext txtTotal (
            content: 'Total Amount: ${1}',
            contentparams: ({1} = $order.TotalAmount),
            rendermode: H4
          )

          actionbutton btnProcess (
            caption: 'Process Order #{1}',
            captionparams: ({1} = $order.OrderNumber),
            action: call microflow PgTest.ProcessProducts,
            buttonstyle: primary
          )
        }
      }
    }
  }
};



-- MARK: Styling

-- ============================================================================
-- Styling Examples - CSS Class and Inline Style
-- ============================================================================
--
-- Any widget can have Class: and Style: properties for CSS styling.
-- Class: adds CSS classes to the widget's Appearance.
-- Style: adds inline CSS styles to the widget's Appearance.
--

create page PgTest.StyledPage folder 'Styling'
(
  params: ( $Customer: PgTest.Customer ),
  title: 'Styled Customer',
  layout: Atlas_Core.Atlas_Default
)
{
  container ctnCard (class: 'card', style: 'padding: 16px; border-radius: 8px;') {
    dataview dvCustomer (datasource: $Customer) {
      textbox txtName (label: 'Name', attribute: Name, class: 'form-control-lg')
      textbox txtEmail (label: 'Email', attribute: Email, style: 'font-style: italic;')
      -- NOTE: an inline `style` on a dynamictext crashes MxBuild — style the
      -- wrapping container instead (the dynamictext keeps its class).
      container ctnCity (style: 'font-size: 12px;') {
        dynamictext dtCity (content: 'City: {1}', contentparams: ({1} = City), class: 'text-muted')
      }

      footer {
        actionbutton btnSave (caption: 'Save', action: save changes, buttonstyle: primary, class: 'btn-block')
        actionbutton btnCancel (caption: 'Cancel', action: cancel changes, class: 'btn-outline')
      }
    }
  }
};

-- MARK: Image Widgets
-- ============================================================================
-- Image Widget Examples
-- ============================================================================
--
-- The BUILT-IN image widgets (`staticimage` -> Forms$StaticImageViewer,
-- `dynamicimage` -> Forms$ImageViewer) are deprecated in the Mendix 11.x
-- React/optimized client (CE0582), so they are deliberately not exercised here.
--
-- `image` is NOT one of them: it routes to the pluggable
-- com.mendix.widget.web.image.Image, which is the current widget and is
-- covered below. This file previously said no pluggable replacement existed
-- and skipped images entirely — so this gate built ZERO image widgets and ran
-- green through two separate image defects: a CE0463 on every image widget
-- mxcli wrote, and an image reference that could not be authored at all. Both
-- are fixed (597db1b2), and both were fixed with nothing here to catch a
-- regression — bug-tests/ documents them but this gate is what CI runs.
--
-- `Image:` names an image-collection asset by its three-part qualified name.
-- Bare and quoted both parse (DESCRIBE emits the quoted form); the bare form
-- is used below to match every other qualified-name property on a page.
-- Atlas_Core.Layout.logo ships with Atlas_Core in every Mendix app.
--
-- The property is effectively REQUIRED even though the widget package declares
-- it optional: an image widget with no source fails the build with
-- [Error] "No image selected.", which is what makes this example a real check
-- rather than a smoke test — omit the `Image:` line and mx check goes red.

create page PgTest.P042_Image
(
  title: 'Image Widget',
  layout: Atlas_Core.Atlas_Default
)
{
  container cImages {
    -- Sized in pixels, so `width` is a VISIBLE property and takes the authored
    -- value by the ordinary route.
    image imgLogoFixed (
      Image: Atlas_Core.Layout.logo,
      WidthUnit: pixels, Width: 36,
      AlternativeText: 'Company logo'
    )

    -- Default units, and the case that actually regressed: under `auto` the
    -- width and height properties are HIDDEN, and a hidden property must be
    -- written with its DECLARED default rather than skipped. Skipping leaves
    -- whatever value the widget template happened to capture — image.json was
    -- extracted from a 48px logo — and 48 against a declared 100 is CE0463 on
    -- every image widget. Nothing in the authored MDL below distinguishes the
    -- two behaviours, which is exactly why it needs a gate rather than a test
    -- that asserts what the script says.
    image imgLogoAuto (Image: Atlas_Core.Layout.logo)

    -- The URL mode, whose source lives in a text template rather than on the
    -- Image field — the two modes reach the picture by different routes.
    image imgFromUrl (ImageType: imageUrl, ImageUrl: 'img/logo.svg')
  }
};

-- The image object in context (mendixlabs/mxcli#1476): an image a user
-- uploaded, held by an object whose entity extends System.Image. `Image:
-- $currentObject` binds the widget to the enclosing data view's or list's
-- object; `DefaultImage:` is shown while that object holds no image. The entity
-- is stored on `imageObject` (and on an unset `defaultImageDynamic`, as Studio
-- Pro does), and mxbuild refuses an entity that is not an image (CE7247).

create persistent entity PgTest.ProductPhoto extends System.Image (
  Caption: String(200)
);

create page PgTest.P042b_ImageObject
(
  title: 'Image Object',
  layout: Atlas_Core.Atlas_Default
)
{
  listview lvPhotos (DataSource: database from PgTest.ProductPhoto) {
    image imgPhoto (
      Image: $currentObject,
      DefaultImage: Atlas_Core.Layout.logo,
      WidthUnit: pixels, Width: 120
    )
  }
};

-- MARK: Custom Container

-- ============================================================================
-- Custom Container Examples
-- ============================================================================
--
-- CUSTOMCONTAINER is an alias for CONTAINER (both map to Forms$DivContainer).
-- Use it when you want a semantic distinction from layout containers.
--

-- ============================================================================
-- P030: Widget Reference Validation
-- ============================================================================
-- Tests that `mxcli check --references` validates all widget references:
-- - DataSource: MICROFLOW and DataSource: DATABASE
-- - Action: MICROFLOW, Action: SHOW_PAGE
-- - SNIPPETCALL Snippet: reference
--
-- All references point to elements created within this script (PgTest module),
-- so this file should pass `mxcli check script.mdl -p app.mpr --references`.

/**
 * Helper microflow for DataSource: MICROFLOW reference validation.
 */
create microflow PgTest.DSO_GetProducts ()
  returns list of PgTest.Product
folder 'WidgetReferences'
begin
  retrieve $Products from PgTest.Product;
  return $Products;
end;

/**
 * Helper microflow for Action: MICROFLOW reference validation.
 */
create microflow PgTest.ACT_RefreshProducts ()
folder 'WidgetReferences'
begin
  return;
end;

/**
 * Target page for Action: SHOW_PAGE reference validation.
 */
create page PgTest.P030_ProductDetail folder 'WidgetReferences'
(
  params: ( $Product: PgTest.Product ),
  title: 'Product Detail',
  layout: Atlas_Core.Atlas_Default,
  url: 'p030_detail/{Product}'
)
{
  dataview dvProduct (datasource: $Product) {
    textbox txtName (label: 'Name', attribute: Name)
  }
};

/**
 * Page exercising all widget reference types for --references validation.
 * References: DataSource MICROFLOW, DataSource DATABASE, Action MICROFLOW,
 * Action SHOW_PAGE, Action CREATE_OBJECT, and SNIPPETCALL.
 */
create page PgTest.P030_WidgetReferences folder 'WidgetReferences'
(
  title: 'Widget Reference Validation',
  layout: Atlas_Core.Atlas_Default,
  url: 'p030_widgetrefs'
)
{
  layoutgrid lg1 {
    row {
      column (desktopwidth: 12) {
        -- DataSource: MICROFLOW reference
        listview lvProducts (datasource: microflow PgTest.DSO_GetProducts) {
          dynamictext txtProductName (content: '{1}', contentparams: ({1} = Name))
        }
      }
    }
    row {
      column (desktopwidth: 12) {
        -- DataSource: DATABASE entity reference
        datagrid dgProducts (datasource: database PgTest.Product) {
          column (attribute: Name, caption: 'Product Name')
          column (attribute: Price, caption: 'Price')
        }
      }
    }
    row {
      column (desktopwidth: 6) {
        -- Action: MICROFLOW reference
        actionbutton btnRefresh (caption: 'Refresh', action: call microflow PgTest.ACT_RefreshProducts)
        -- Action: CREATE_OBJECT entity reference (with target page)
        actionbutton btnNew (caption: 'New Product', action: create object PgTest.Product then show page PgTest.P030_ProductDetail)
      }
      column (desktopwidth: 6) {
        -- SNIPPETCALL reference
        snippetcall scStats (snippet: PgTest.StatsPanel)
      }
    }
    row {
      column (desktopwidth: 12) {
        -- Action: SHOW_PAGE reference (inside list context for parameter passing)
        listview lvForAction (datasource: microflow PgTest.DSO_GetProducts) {
          actionbutton btnDetail (caption: 'View Detail', action: show page PgTest.P030_ProductDetail (Product = $currentObject))
        }
      }
    }
  }
};

/**
 * Page using CUSTOMCONTAINER for card-style layout.
 */
create page PgTest.P029_CustomContainer folder 'Container'
(
  title: 'Custom Container',
  layout: Atlas_Core.Atlas_Default,
  url: 'p029_customcontainer'
)
{
  layoutgrid mainGrid {
    row {
      column (desktopwidth: 6) {
        customcontainer card1 (class: 'card', style: 'padding: 16px;') {
          dynamictext cardTitle1 (content: 'Card Title', rendermode: H4)
          dynamictext cardBody1 (content: 'Card body content', rendermode: paragraph)
        }
      }
      column (desktopwidth: 6) {
        customcontainer card2 (class: 'card') {
          dynamictext cardTitle2 (content: 'Another Card', rendermode: H4)
          container cardInner (class: 'card-body') {
            dynamictext cardBody2 (content: 'Nested container inside custom container')
          }
        }
      }
    }
  }
};


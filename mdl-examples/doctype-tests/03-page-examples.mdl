      column (desktopwidth: 6) {
        actionbutton btnSave (caption: 'Save {1}', captionparams: ({1} = 'Hello'), action: save changes, buttonstyle: primary)
      }
      column (desktopwidth: 6) {
        actionbutton btnCancel (caption: 'Cancel', action: cancel changes)
        -- linkbutton renders an action button as a link (Forms$ActionButton, RenderType=Link)

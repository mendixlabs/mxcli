/**
 * Show only active products with complex filter.
 */
create page PgTest.P010_2_Product_Sorted_filtered folder 'DataGrid'
(
  title: 'Active Products',
  layout: Atlas_Core.Atlas_Default,
  url: 'PgTest.P010_2_Product_Sorted_filtered'
)
{
  datagrid ProductGrid (
    datasource: database from PgTest.Product
      where [IsActive = true() and contains(Code, 'a') and Price > 10] or [Stock < 2]
      sort by Name asc, Price desc
  ) {
    column (attribute: Name, caption: 'Product Name')
    column (attribute: Code, caption: 'SKU')
    column (attribute: Price, caption: 'Unit Price')
    column (attribute: Stock, caption: 'Available')
    column (attribute: IsActive, caption: 'Active')
  }
};

/**
 * Show only active products with complex filter.
 */
create page PgTest.P010_Product_Sorted_filtered_styled folder 'DataGrid'
(
  title: 'Active Products',
  layout: Atlas_Core.Atlas_Default,
  url: 'PgTest.P010_Product_Sorted_styled'
)
{
  datagrid ProductGrid (
    datasource: database from PgTest.Product
      where [IsActive = true() and contains(Code, 'a') and Price > 10] or [Stock < 2]
      sort by Name asc, Price desc,
    class: 'datagrid-striped datagrid-hover datagrid-sm',
    selection: multiple,
    PageSize: 10,
    Pagination: buttons,
    PagingPosition: both
  ) {
    column (attribute: Name, caption: 'Product Name', Alignment: left, WrapText: false)
    column (attribute: Code, caption: 'SKU')
    column (attribute: Price, caption: 'Unit Price', Alignment: right, WrapText: false)
    column (attribute: Stock, caption: 'Available', Alignment: right, WrapText: false)
    column (attribute: IsActive, caption: 'Active')
  }
};

/**
 * Show only active products with complex filter.
 */
create page PgTest.P010_Product_Sorted_filtered_styled_2 folder 'DataGrid' (
  title: 'Active Products',
  layout: Atlas_Core.Atlas_Default,
  url: 'PgTest.P010_Product_Sorted_styled_2'
) {
  datagrid ProductGrid ( 
    datasource:  database from PgTest.Product where (IsActive = true() and contains(Code, 'a') and Price > 10) or (Stock < 2) sort by PgTest.Product.Name asc, PgTest.Product.Price desc, 
    PageSize: 10, 
    PagingPosition: both, 
    designproperties: ('Compact': on, 'Striped': on, 'Hover': on, 'Borders': 'Horizontal')
  ) {
    column (attribute: Name, caption: 'Product Name', Alignment: left, WrapText: false, designproperties: ('Compact': on, 'Striped': on, 'Hover': on, 'Borders': 'Horizontal'))
    column (attribute: Code, caption: 'SKU')
    column (attribute: Price, caption: 'Unit Price', Alignment: right, WrapText: false)
    column (attribute: Stock, caption: 'Available', Alignment: right, WrapText: false)
    column (attribute: IsActive, caption: 'Active')
  }
};

/**
 * Helper microflow for DataSource: MICROFLOW reference validation.
 */
create microflow PgTest.P010_DSO_GetProducts ()
  returns list of PgTest.Product
folder 'DataGrid'
begin
  retrieve $Products from PgTest.Product;
  return $Products;
end;

/**
 * Show only active products with complex filter.
 */
create page PgTest.P010_Product_Microflow_DataSource folder 'DataGrid' (
  title: 'Active Products',
  layout: Atlas_Core.Atlas_Default,
  url: 'PgTest.P010_Product_Microflow_DataSource'
) {
  datagrid ProductGrid ( 
    datasource: microflow PgTest.P010_DSO_GetProducts ,
    PageSize: 10, 
    PagingPosition: both, 
    designproperties: ('Compact': on, 'Striped': on, 'Hover': on, 'Borders': 'Horizontal')
  ) {
    column (attribute: Name, caption: 'Product Name', Alignment: left, WrapText: false, designproperties: ('Compact': on, 'Striped': on, 'Hover': on, 'Borders': 'Horizontal'))
    column (attribute: Code, caption: 'SKU')
    column (attribute: Price, caption: 'Unit Price', Alignment: right, WrapText: false)
    column (attribute: Stock, caption: 'Available', Alignment: right, WrapText: false)
    column (attribute: IsActive, caption: 'Active')
  }
};


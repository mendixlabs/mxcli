          template {
            dynamictext prodName (content: '{1}',contentparams:({1}=Name), rendermode: H4)
            dynamictext prodStock (content: 'Stock: {1}',contentparams:({1}=Stock), rendermode: text)
          }
        }
      }
    }
    row {
      column (desktopwidth: 12) {
        actionbutton btnProcess (caption: 'Process Selected', action: call microflow PgTest.ProcessProducts, buttonstyle: primary)
      }
    }
  }
};


/**

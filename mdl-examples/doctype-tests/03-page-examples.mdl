-- MARK: GroupBox Examples

-- ============================================================================
-- LEVEL 8: GroupBox Container Examples
-- ============================================================================

/**
 * Customer edit form with GroupBox containers for organizing fields.
 * GroupBox creates a collapsible section with a header caption.
 *
 * @param $Customer The customer to edit
 */
create page PgTest.P037_GroupBox_Example folder 'GroupBox'
(
  params: (
    $Customer: PgTest.Customer
  ),
  title: 'GroupBox Example',
  layout: Atlas_Core.PopupLayout
)
{
  dataview dvCustomer (datasource: $Customer) {
    -- GroupBox with caption and H3 header, collapsible (initially expanded)
    groupbox gbPersonal (caption: 'Personal Information', HeaderMode: H3, Collapsible: YesExpanded) {
      textbox txtName (label: 'Name', attribute: Name)
      textbox txtEmail (label: 'Email', attribute: Email)
      textbox txtPhone (label: 'Phone', attribute: Phone)
    }

    -- GroupBox with caption and H4 header, collapsible (initially collapsed)
    groupbox gbAddress (caption: 'Address', HeaderMode: H4, Collapsible: YesCollapsed) {
      textbox txtAddress (label: 'Address', attribute: Address)
      textbox txtCity (label: 'City', attribute: City)
      combobox cmbCountry (label: 'Country', attribute: Country)
    }

    -- GroupBox with default header (Div), not collapsible
    groupbox gbStatus (caption: 'Status') {
      radiobuttons rbIsActive (label: 'Is Active', attribute: IsActive)
      datepicker dpCreateDate (label: 'Created On', attribute: CreateDate)
    }

    footer {
      actionbutton btnSave (caption: 'Save', action: save changes close page, buttonstyle: success)
      actionbutton btnCancel (caption: 'Cancel', action: cancel changes close page, buttonstyle: default)
    }
  }
};

/**
 * Order edit form with ComboBoxes in association mode.
 * Attribute is the association name on the context entity (e.g., Order_Customer).
 * DataSource specifies which entity to load selectable objects from.
 * CaptionAttribute is the display attribute on the target entity (shown in dropdown).
 *
 * - Enum mode: COMBOBOX name (Attribute: EnumAttr)
 * - Association mode: COMBOBOX name (Attribute: AssocName, DataSource: DATABASE TargetEntity, CaptionAttribute: DisplayAttr)
 *
 * @param $Order The order to edit
 */
create page PgTest.P036_ComboBox_Association folder 'ComboBox'
(
  params: (
    $Order: PgTest.Order
  ),
  title: 'ComboBox Association Selection',
  layout: Atlas_Core.PopupLayout
)
{
  dataview dvOrder (datasource: $Order) {
    textbox txtOrderNumber (label: 'Order Number', attribute: OrderNumber)

    -- ComboBox (association mode) selecting a Customer — shows Name in dropdown
    combobox cmbCustomer (label: 'Customer', attribute: Order_Customer, datasource: database PgTest.Customer, CaptionAttribute: Name)

    -- ComboBox (association mode) selecting a Product — shows Name in dropdown
    combobox cmbProduct (label: 'Product', attribute: Order_Product, datasource: database PgTest.Product, CaptionAttribute: Name)

    textbox txtTotal (label: 'Total Amount', attribute: TotalAmount)

    footer {
      actionbutton btnSave (caption: 'Save', action: save changes close page, buttonstyle: success)
      actionbutton btnCancel (caption: 'Cancel', action: cancel changes close page, buttonstyle: default)
    }
  }
};

-- ============================================================================================ --

-- MARK: Layout Placeholders (issue #532)

-- ============================================================================
-- LEVEL: assign widgets to specific layout placeholders
-- ============================================================================
-- Atlas_Core.Atlas_SideBar has two placeholders: Main and Topbar. A
-- `placeholder <Name> { … }` block binds its widgets to that placeholder; bare
-- widgets (none here) would bind to Main. DESCRIBE round-trips the blocks.

create page PgTest.P041_Placeholders
(
  title: 'Multiple Placeholders',
  layout: Atlas_Core.Atlas_SideBar
)
{
  placeholder Main {
    dynamictext lblMain (content: 'This widget is in the Main placeholder', rendermode: H2)
  }
  placeholder Topbar {
    dynamictext lblTop (content: 'This widget is in the Topbar placeholder')
  }
};

-- ============================================================================================ --

-- MARK: ALTER PAGE Variable Examples

-- =============================================================================
-- ALTER PAGE - ADD / DROP Page Variables
-- =============================================================================
--
-- Page variables (Forms$LocalVariable) can be added to or removed from existing
-- pages and snippets using ALTER PAGE / ALTER SNIPPET with ADD/DROP Variables.
--

-- Add a boolean page variable for controlling column visibility
alter page PgTest.P033b_DataGrid_ColumnProperties {
  add variables $showPriceColumn: boolean = true;
};

-- Add a string variable with an escaped string default
alter page PgTest.P033b_DataGrid_ColumnProperties {
  add variables $filterMode: string = '''active''';
};

-- Drop a page variable by name
alter page PgTest.P033b_DataGrid_ColumnProperties {
  drop variables $filterMode;
};

-- Multiple variable operations in a single ALTER statement
alter page PgTest.P033b_DataGrid_ColumnProperties {
  add variables $pageSize: integer = 20;
  drop variables $showPriceColumn;
};

-- MARK: ALTER PAGE SET Layout

-- =============================================================================
-- ALTER PAGE - SET Layout (change page layout without rebuilding widgets)
-- =============================================================================

/**
 * Level 8.1: Change page layout (auto-map placeholders)
 */
alter page PgTest.P033b_DataGrid_ColumnProperties {
  set layout = Atlas_Core.Atlas_Default;
};

/**
 * Level 8.2: Change layout back (auto-map)
 */
alter page PgTest.P033b_DataGrid_ColumnProperties {
  set layout = Atlas_Core.Atlas_TopBar;
};

-- MARK: ALTER PAGE DataGrid Column Operations

-- =============================================================================
-- ALTER PAGE - DataGrid Column Operations (dotted widget references)
-- =============================================================================
--
-- DataGrid2 columns are addressable using gridName.columnName syntax.
-- Column names are derived from the attribute short name or caption.

-- DROP a column by dotted reference
-- Note: column names depend on DataGrid2 widget version; disabled for cross-version compat
-- ALTER PAGE PgTest.P033b_DataGrid_ColumnProperties {
--   DROP WIDGET dgProducts.Description
-- };

-- MARK: Conditional Visibility/Editability and Responsive Widths

-- =============================================================================
-- LEVEL 9: Conditional Visibility, Editability, and Responsive Column Widths
-- =============================================================================

create microflow PgTest.DS_GetFirstCustomer ()
  returns PgTest.Customer  
folder 'DataSources'
begin
  retrieve $Customer from PgTest.Customer first;
  return $Customer;
end;


-- @version: 11.0+
/**
 * Level 9.1: Page with conditional visibility and editability
 */
create page PgTest.P040_ConditionalProps
(
  title: 'Conditional Properties',
  layout: Atlas_Core.Atlas_Default
)
{
  layoutgrid lg1 {
    row {
      column (desktopwidth: 8, tabletwidth: 6, phonewidth: 12) {
        dataview dv1 (datasource: microflow PgTest.DS_GetFirstCustomer) {
          textbox txtName (label: 'Name', attribute: Name, visible: $currentObject/Name != empty)
          textbox txtPhone (label: 'Phone', attribute: Phone, editable: [true])
        }
      }
      column (desktopwidth: 4, tabletwidth: 6, phonewidth: 12) {
        dynamictext sidebarText (content: 'Sidebar')
      }
    }
  }
};

-- @version: any
-- MARK: Move Examples

-- =============================================================================
-- MOVE Examples - Moving Documents Between Folders and Modules
-- =============================================================================
--
-- MOVE changes the location of an existing document (page, snippet, microflow,
-- entity) to a different folder or module. Folders are auto-created.
--

-- Create a second module for cross-module move examples
create module PgTest2;

-- Move a page to a different folder within the same module
move page PgTest.P001_Empty_Page to folder 'Pages/Archive';

-- @version: 11.0+
-- Move a microflow to a subfolder (ProcessProducts created under 11.0+ gate)
move microflow PgTest.ProcessProducts to folder 'MasterDetail/Actions';

-- Move snippets to a nested folder (DashboardHeader/Footer created under 11.0+ gate)
move snippet PgTest.DashboardHeader to folder 'Snippets/Dashboard';
move snippet PgTest.DashboardFooter to folder 'Snippets/Dashboard';

-- Move a page to another module (P034 uses page params, 11.0+ only)
move page PgTest.P034_ComboBox_Enum to PgTest2;

-- Move a page to a folder in another module
move page PgTest2.P034_ComboBox_Enum to folder 'Imported' in PgTest2;

-- Move a snippet to another module (QuickActions created under 11.0+ gate)
move snippet PgTest.QuickActions to PgTest2;

-- Move a snippet to a folder in another module (CustomerSidebar created under 11.0+ gate)
move snippet PgTest.CustomerSidebar to folder 'Shared' in PgTest2;

-- @version: any

-- ============================================================================
-- Summary - MDL Page Syntax Features
-- ============================================================================
--
-- Key syntax elements:
-- - Page header uses single () block with Params:, Title:, Layout:, Url:
-- - DataSource: property replaces -> for containers (DATAVIEW, DATAGRID, GALLERY)
-- - Attribute: property replaces -> for input widgets (TEXTBOX, CHECKBOX, etc.)
-- - Action: property replaces -> for buttons and navigation items
-- - Caption: property replaces bare string for button text
-- - Label: property replaces bare string for input widget labels
-- - All layout elements (ROW, COLUMN) require names
-- - ContentParams: and CaptionParams: replace WITH syntax for string templates
-- - Attribute: and Caption: for DATAGRID columns instead of 'caption' -> attr
-- - CONTROLBAR and FILTER are explicit child containers with names
-- - TEMPLATE requires a name
--
-- Core pattern: WIDGET name (Prop: Value, Prop: Value) { children }
--
-- DataSource types:
-- - DataSource: $ParameterName (page parameter)
-- - DataSource: DATABASE Entity (database query)
-- - DataSource: MICROFLOW Module.Flow (microflow source)
-- - DataSource: NANOFLOW Module.Flow (nanoflow source)
-- - DataSource: ASSOCIATION Path (association source)
-- - DataSource: SELECTION widgetName (selection binding)
--
-- Action types:
-- - Action: SAVE_CHANGES
-- - Action: SAVE_CHANGES CLOSE_PAGE
-- - Action: CANCEL_CHANGES
-- - Action: CANCEL_CHANGES CLOSE_PAGE
-- - Action: CLOSE_PAGE
-- - Action: DELETE_OBJECT
-- - Action: CREATE_OBJECT Entity THEN SHOW_PAGE Page
-- - Action: SHOW_PAGE Page
-- - Action: SHOW_PAGE Page(Param: $value)
-- - Action: MICROFLOW Module.Flow
-- - Action: MICROFLOW Module.Flow(Param: $value)
-- - Action: NANOFLOW Module.Flow
-- - Action: NANOFLOW Module.Flow(Param: $value)
--
-- Parameter values in actions:
-- - $ParameterName: Reference page/snippet parameter (e.g., $Product)
-- - $currentObject: Reference current row in DATAGRID/GALLERY/LISTVIEW columns
-- - 'literal': String literal values
--
-- ============================================================================

-- MARK: Workflow task completion buttons

-- ACTIONBUTTON with action: complete_task 'OutcomeName' submits a workflow
-- user task outcome directly from the page. Used on pages bound to
-- System.WorkflowUserTask.

-- @version: 11.0+
create page PgTest.UserTaskPage (
  title: 'User Task Page',
  layout: Atlas_Core.Atlas_Default,
  params: ( $WorkflowUserTask: System.WorkflowUserTask )
) {
  actionbutton btnApprove (
    caption: 'Approve',
    action: complete task 'Approve',
    buttonstyle: success
  )
  actionbutton btnReject (
    caption: 'Reject',
    action: complete task 'Reject',
    buttonstyle: danger
  )
};

-- ============================================================================
-- Association data source ("data from context") — to-one referenced object
-- ============================================================================
-- A nested DATAVIEW can bind over an association to show the to-one REFERENCED
-- object's attributes. Order_Customer is `from Order to Customer`, so from an
-- Order it navigates to the one Customer; the inner DataView's children bind to
-- Customer. (A to-many collection uses a list widget over the association — see
-- master-detail-pages.md.)
create page PgTest.P_OrderWithCustomer (
  Title: 'Order + Customer',
  Layout: Atlas_Core.Atlas_Default,
  Params: ( $Order: PgTest.Order )
)
{
  dataview dvOrder (DataSource: $Order) {
    textbox tbNumber (Label: 'Order #', Attribute: OrderNumber)
    dataview dvCustomer (DataSource: $currentObject/PgTest.Order_Customer) {
      textbox tbCustName (Label: 'Customer', Attribute: Name)
      textbox tbCustEmail (Label: 'Email', Attribute: Email)
    }
  }
};

-- ============================================================================
-- MARK: An explicitly inert widget — `action: nothing`
-- ============================================================================
-- NOTHING is the spelling for a control that is deliberately wired to no
-- action: a button that only carries a caption for a layout, a container that
-- is styled as a card but is not clickable. It writes Forms$NoAction.
--
-- It is here because it only became a real action expression in
-- mendixlabs/mxcli#1062. Before that it was documented and used but absent from
-- the grammar: it reached Forms$NoAction by FAILING to parse as an action and
-- falling through to the generic property branch, which stores the slot as a
-- plain string. `Action: OPEN_LINK` (a real keyword short its argument) and
-- `Action: TOTALLY_MADE_UP` took the same route to the same dead widget, with
-- check, exec and mxbuild all clean — so the fall-through could not be rejected
-- until this form had a branch of its own.
--
-- The gate is the point: this must survive `exec` into a real project and
-- `mx check`, which is what distinguishes a promoted grammar form from one that
-- parses and then cannot be written (the builder's action switch ends in a
-- `default:` that refuses unknown types).
create page PgTest.P014_InertControls (
  Title: 'Inert controls',
  Layout: Atlas_Core.Atlas_Default
)
{
  actionbutton btnDecorative (Caption: 'Decorative', Action: NOTHING)
  linkbutton lnkDecorative (Caption: 'Also decorative', action: nothing)
  container cCard (OnClick: NOTHING, Class: 'card') {
    dynamictext txtCard (Content: 'A card that is not clickable')
  }
};

-- ============================================================================
-- MARK: Submit while typing, and a fixed-width layout grid
-- ============================================================================
-- SubmitBehaviour (OnEndEditing default | WhileEditing) and SubmitOnInputDelay
-- (milliseconds, default 300) are a text box's and a text area's; Width
-- (FullWidth default | FixedWidth) is a layout grid's. describe prints each only
-- when it is not the default. Before ako/mxcli-ledger FINDINGS #170 the writer
-- hard-coded the defaults, so describe -> exec reset a Studio Pro page's
-- WhileEditing and FixedWidth, and check accepted the property and dropped it.
create page PgTest.P043_SubmitWhileTyping (
  Title: 'Search customers',
  Layout: Atlas_Core.Atlas_Default,
  Params: ( $Customer: PgTest.Customer )
)
{
  layoutgrid gridFixed (Width: FixedWidth) {
    row {
      column (DesktopWidth: 12) {
        dataview dvCustomer (DataSource: $Customer) {
          textbox tbName (Label: 'Name', Attribute: Name, SubmitBehaviour: WhileEditing, SubmitOnInputDelay: 500)
          textarea taAddress (Label: 'Address', Attribute: Address, SubmitBehaviour: WhileEditing)
          textbox tbEmail (Label: 'Email', Attribute: Email)
        }
      }
    }
  }
};

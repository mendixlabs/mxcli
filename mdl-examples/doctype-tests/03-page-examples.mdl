/**
 * Gallery showing customers with single selection.
 */
create page PgTest.P019_Gallery_Simple folder 'MasterDetail'
(
  title: 'Customer Gallery',
  layout: Atlas_Core.Atlas_Default,
  url: 'p019_gallery_simple'
)
{
  layoutgrid mainGrid {
    row {
      column (desktopwidth: 12) {
        dynamictext pageTitle (content: 'Customer Gallery', rendermode: H3)
      }
    }
    row {
      column (desktopwidth: 12) {
        gallery customerGallery (
          datasource: database from PgTest.Customer sort by Name asc,
          selection: single
        ) {
          template {
            dynamictext custName (content: '{1}',contentparams:({1}=Name), rendermode: H4)
            dynamictext custEmail (content: '{1}',contentparams:({1}=Email), rendermode: text)
            dynamictext custCity (content: '{1}',contentparams:({1}=City), rendermode: text)
          }
        }
      }
    }
  }
};

/**
 * Classic master-detail layout.
 *
 * The gallery must use `Selection: Single` AND `ItemSelectionMode: toggle`
 * — without `toggle`, Studio Pro rejects the DataView with:
 *   "A data view cannot listen to the selection of a gallery 'customerList',
 *    because it is not available here."
 * (The default `clear` mode means clicking re-selects only; the DataView
 * binding requires click-to-toggle so the selection is observable.)
 */
create page PgTest.P020_Master_Detail folder 'MasterDetail'
(
  title: 'Customer Master-Detail',
  layout: Atlas_Core.Atlas_Default,
  url: 'p020_master_detail'
)
{
  layoutgrid mainGrid {
    row {
      -- Master list (4 columns)
      column (desktopwidth: 4) {
        dynamictext masterTitle (content: 'Customers: {1}',contentparams:({1}='too many'), rendermode: H3)
        gallery customerList (
          datasource: database from PgTest.Customer sort by Name asc,
          selection: single,
          ItemSelectionMode: toggle
        ) {
          template {
            dynamictext custName (content: '{1}',contentparams:({1}=Name), rendermode: H4)
            dynamictext custEmail (content: 'Email: {1}',contentparams:({1}=Email), rendermode: text)
          }
        }
      }

      -- Detail form (8 columns)
      column (desktopwidth: 8) {
        dynamictext detailTitle (content: 'Customer Details', rendermode: H3)
        dataview customerDetail (datasource: selection customerList) {
          textbox txtName (label: 'Name', attribute: Name)
          textbox txtEmail (label: 'Email', attribute: Email)
          textbox txtPhone (label: 'Phone', attribute: Phone)
          textbox txtAddress (label: 'Address', attribute: Address)
          textbox txtCity (label: 'City', attribute: City)

          footer {
            actionbutton btnSave (caption: 'Save', action: save changes, buttonstyle: success)
            actionbutton btnCancel (caption: 'Cancel', action: cancel changes, buttonstyle: default)
          }
        }
      }
    }
  }
};


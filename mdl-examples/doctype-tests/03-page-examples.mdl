/**
 * Full CRUD operations on products.
 */
create page PgTest.P012_Product_Manage folder 'DataGrid'
(
  title: 'Product Management',
  layout: Atlas_Core.Atlas_Default,
  url: 'P012_Product_Manage'
)
{
  layoutgrid buttonRow {
    row {
      column (desktopwidth: 12) {
        dynamictext textIntro (content: 'P008_Product_Overview', rendermode: H3)
        dynamictext textIntro2 (content: 'P008_Product_Overview: {1}', contentparams: ({1}='abc'), rendermode: H3)
      }
    }
    row {
      column (desktopwidth: 12) {
        datagrid ProductGrid (datasource: database PgTest.Product) {
          controlbar {
            actionbutton btnNew1 (
              caption: 'New',
              action: create object PgTest.Product then show page PgTest.P012_Product_Manage_Edit,
              buttonstyle: primary
            )
          }
          column (attribute: Name, caption: 'Product Name')
          column (attribute: Code, caption: 'SKU')
          column (attribute: Price, caption: 'Price')
          column (attribute: Stock, caption: 'In Stock')
          column (attribute: IsActive, caption: 'Active')
          column (caption: 'Actions') {
            -- `icon:` gives the button an icon-collection icon (Atlas). The name
            -- must exist in the icon collection or MxBuild rejects it (CE1613).
            actionbutton btnEdit (
              caption: 'Edit',
              action: show page PgTest.P012_Product_Manage_Edit (Product = $currentObject),
              buttonstyle: default,
              icon: 'Atlas_Core.Atlas_Filled.pencil'
            )
            actionbutton btnDelete (caption: 'Delete', action: delete, buttonstyle: danger)
          }
        }
      }
    }
  }
};


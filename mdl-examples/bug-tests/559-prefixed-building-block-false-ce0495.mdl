mdl 1;
-- Bug ako/mxcli#559: placing one building block several times, each with its
-- own `as <prefix>`, was refused by `check --references`:
--   duplicate widget name 'Atlas_Web_Content.Card' (used 4 times)
--   — Mendix requires unique widget names per page (CE0495)
-- check counted the `use building block` statement as a widget named after the
-- block, before expansion; exec expands and prefixes (a_container2,
-- b_container2, …) and mx check reports no CE0495.
--
-- Fix: the page-context check counts the names of the EXPANDED tree
-- (expandUseRefsForCheck). The same block placed twice WITHOUT a prefix is
-- still reported, by its real widget names ('container2', 'text22'), which is
-- what exec refuses.
--
-- Verify (needs a project with Atlas_Web_Content, e.g. `mxcli new`):
--   mxcli check 559-prefixed-building-block-false-ce0495.mdl -p app.mpr --references
--   passes; exec writes a_/b_/c_/d_ copies; mxcli docker check: 0 errors.

create module BugTest559;

create page BugTest559.Dashboard (Title: 'Dashboard', Layout: Atlas_Core.Atlas_Default) {
  use building block Atlas_Web_Content.Card as a_
  use building block Atlas_Web_Content.Card as b_
  use building block Atlas_Web_Content.Card as c_
  use building block Atlas_Web_Content.Card as d_
};

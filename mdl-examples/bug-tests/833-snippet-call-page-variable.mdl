mdl 1;
-- ako/mxcli#833: a page variable passed to a snippet parameter passed check and
-- exec, then mx check reported
--   [CE0115] "The arguments that are passed to snippet 'BugTest833f.SN' do not
--   match the expected parameters and need to be refreshed." at Snippet call 'sc1'
-- A page variable is primitive and this snippet parameter is an object, so it
-- can never match: exec refuses it (the snippet-call builder, naming CE0115).
--
-- This file used to be 833-snippet-call-page-variable.fail.mdl, refused by the
-- project-free `mxcli check` (MDL-WIDGET34). From Mendix 11.17 a snippet
-- parameter may be primitive, and then a page variable is a valid argument —
-- which a check without a project cannot tell apart from this case, as it
-- cannot see the called snippet's parameter types. The builder can: it refuses
-- an entity parameter and takes a primitive one. Covered by
-- mdl/executor/validate_template_param_dataview_833_test.go and
-- snippet_param_primitive_test.go (TestSnippetCall_PageVariableToPrimitiveParameter).
create module BugTest833f;
create persistent entity BugTest833f.Item (Name: String(50));
create snippet BugTest833f.SN (Params: ($Item: BugTest833f.Item)) {
  dataview dvIn (DataSource: $Item) { dynamictext t (Content: '{1}', ContentParams: ({1} = Name)) }
};
create page BugTest833f.P (Title: 'P', Layout: Atlas_Core.Atlas_Default, Params: ($Item: BugTest833f.Item), Variables: ($Flag: Boolean = true)) {
  snippetcall sc1 (Snippet: BugTest833f.SN, Params: (Item = $Flag))
};

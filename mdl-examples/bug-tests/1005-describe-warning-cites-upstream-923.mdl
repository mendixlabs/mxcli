mdl 1;
-- ako/mxcli#1005: describe's warnings for a decision whose branches do not nest
-- (and its NOTE for a NORMALIZED rendering, and the unrepresented-merge warning)
-- cited "mxcli #923". In the ako/mxcli fork #923 is an unrelated MCP-backend
-- issue; the one meant is mendixlabs/mxcli#923 ("roundtrip for @merge does not
-- work"), and the text now names it with its owner.
--
-- The graph below is mendixlabs/mxcli#923's own:
--   split1: true -> split2      false -> merge1
--   split2: true -> merge1      false -> merge2
--   merge1 -> log -> merge2 -> end
--
-- To see a citation:
--   mxcli exec 1005-describe-warning-cites-upstream-923.mdl -p app.mpr
--   mxcli -p app.mpr -c "describe microflow BugTest1005.Crossing normalized"
-- The NOTE line ends "(mendixlabs/mxcli#923, Mode 3)", never "(mxcli #923, ...)".

create module BugTest1005;

create microflow BugTest1005.Crossing ($A: Boolean, $B: Boolean)
begin
  if $A then
    if $B then
      join shared_log;
    else
      join after_log;
    end if;
  else
    join shared_log;
  end if;
  merge shared_log;
  log info node 'BugTest1005' 'shared';
  join after_log;
  merge after_log;
end;
